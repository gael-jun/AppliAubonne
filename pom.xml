<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<project xmlns="https://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>appli_pre_etudes</groupId>
  <artifactId>appli_pre_etudes</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  
  <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
     <!-- Default empty value so Surefire does not pass a literal "${jacocoArgLine}" token
       when the coverage profile isn't active. The JaCoCo plugin (when -Pcoverage) will
       override this property during the initialize phase. -->
     <jacocoArgLine/>
  </properties>
  
  <profiles>
    <!-- Activate with: mvn verify -Pcoverage (recommend using a JDK 21) -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.11</version>
            <executions>
              <execution>
                <id>jacoco-prepare-agent</id>
                <phase>initialize</phase>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <configuration>
                  <!-- Use a distinct propertyName so we do not clash with any user-defined argLine -->
                  <propertyName>jacocoArgLine</propertyName>
                  <append>true</append>
                </configuration>
              </execution>
              <execution>
                <id>jacoco-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                  <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                  <!-- Filter coverage reporting strictly to requested functional scope -->
                  <includes>
                    <!-- Use only direct package + one-level subpackages for target domains -->
                    <include>service.pvgis.*</include>
                    <include>service.finance.*</include>
                    <include>service.validation.*</include>
                    <include>service.export.*</include>
                    <include>service.export.pdf.*</include>
                    <include>modele.pvgis.*</include>
                    <include>modele.finance.*</include>
                    <include>controleur.EstimationProd.*</include>
                  </includes>
                  <!-- No excludes here: anything not matched by includes is ignored. -->
                </configuration>
              </execution>
              <execution>
                <id>dump</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>dump</goal>
                </goals>
                <configuration>
                  <dump>true</dump>
                  <output>file</output>
                </configuration>
              </execution>
            </executions>
            <configuration>
              <excludes>
                <exclude>**/vue/**</exclude>
                <!-- Exclude application entry point package -->
                <exclude>main/**/*</exclude>
                <!-- Exclude generic legacy controller not part of EstimationProd scope -->
                <exclude>controleur/Controleur*</exclude>
                <!-- Exclude non-target model subpackage -->
                <exclude>modele/cablesetprotections/**</exclude>
                <!-- Exclude root modele classes (keep only modele.pvgis & modele.finance) -->
                <exclude>modele/Calcul.class</exclude>
                <exclude>modele/EFU.class</exclude>
                <exclude>modele/EtudeDUnePente.class</exclude>
                <exclude>modele/EtudeDUnModule.class</exclude>
                <exclude>modele/EtudeDUnOnduleur.class</exclude>
                <exclude>modele/InvalidFormatException.class</exclude>
                <exclude>modele/Module.class</exclude>
                <exclude>modele/NullDataException.class</exclude>
                <exclude>modele/Onduleur.class</exclude>
                <exclude>modele/Pente.class</exclude>
              </excludes>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <append>true</append>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <!-- JaCoCo baseline always-on (prepare-agent + verify report) integrated into main build plugins -->
  
  <dependencies>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>5.3.0</version>
    </dependency>
    <dependency>
	    <groupId>org.apache.poi</groupId>
	    <artifactId>poi-ooxml</artifactId>
	    <version>5.3.0</version>
</dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20231013</version>
    </dependency>
    <dependency>
      <groupId>org.knowm.xchart</groupId>
      <artifactId>xchart</artifactId>
      <version>3.8.6</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>2.0.30</version>
    </dependency>
    <!-- JUnit 5 (API + Engine) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.12.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>ressources</directory>
        <filtering>false</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- Surefire pour exécuter les tests JUnit 5 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
    <!-- Workaround: erreurs "Corrupted channel" causées par des warnings CDS du JDK.
      On réactive un fork isolé mais on désactive le CDS (-Xshare:off) pour supprimer les warnings
      et on force le mode headless pour éviter toute initialisation AWT/Swing pendant les tests. -->
  <forkCount>1</forkCount>
  <reuseForks>false</reuseForks>
  <!-- Force forked JVM to match JAVA_HOME (set it to a JDK 21 as in README) -->
  <jvm>${env.JAVA_HOME}\bin\java</jvm>
  <!-- Single consolidated argLine includes JaCoCo agent (in ${jacocoArgLine}) plus extra JVM flags -->
  <!-- Include the JaCoCo injected agent arguments when profile active (property populated at runtime). -->
  <argLine>${jacocoArgLine} -Xshare:off -Djava.awt.headless=true -Dnet.bytebuddy.experimental=true</argLine>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <printSummary>true</printSummary>
          <failIfNoTests>true</failIfNoTests>
          <!-- Write reports to files to reduce console channel pressure on Windows -->
          <useFile>true</useFile>
          <trimStackTrace>false</trimStackTrace>
          <reportFormat>plain</reportFormat>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <mainClass>main.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <additionalJOption>-quiet</additionalJOption>
          <!-- Exclude legacy placeholder package -->
          <excludePackageNames>vue.ui.actions.*</excludePackageNames>
          <doclint>none</doclint>
          <show>public</show>
          <detectOfflineLinks>false</detectOfflineLinks>
          <failOnError>false</failOnError>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>21</release>
          <fork>true</fork>
          <showDeprecation>true</showDeprecation>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Xdiags:verbose</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
      	<groupId>org.apache.maven.plugins</groupId>
      	<artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <archive>
            <manifest>
              <mainClass>main.Main</mainClass>
            </manifest>
          </archive>
          <finalName>${project.artifactId}-${project.version}</finalName>
          <appendAssemblyId>true</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <id>run-main-after-package</id>
            <phase>package</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>main.Main</mainClass>
              <cleanupDaemonThreads>true</cleanupDaemonThreads>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Build helper now limited to explicit production subfolders inside legacy 'src' tree -->
    </plugins>
  </build>
</project>
